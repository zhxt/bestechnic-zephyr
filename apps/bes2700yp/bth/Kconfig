mainmenu "BES2700YP dual-core validation"
source "Kconfig.zephyr"
config DUAL_CC_PAIR
 hex "Message image pair identity"
 default 0
config DUAL_M55_BUILD
 hex "M55 image source identity"
 default 0

config BTH_LOG_PREFIX
 bool
 default y
config DUAL_DURATION_SECONDS
 int "Dual heartbeat duration in seconds"
 range 600 3610
 default 3610

config DUAL_IPC_SECONDS
 int "Active concurrent traffic duration"
 range 600 3600
 default 3600

config DUAL_MSG_MODE
 int "Message validation: 1=sequential, 2=concurrent, 3=negative"
 range 1 3
 default 1

config BES2700_M55_RESTART
 bool "Validate RAM-retained M55 CPU restart"
 default n

config BES2700_M55_FAULT_CASE
 int "M55 fault injection: 0=off, 1=READY, 2=heartbeat, 3=IPC, 4=QUIESCE, 5=fatal, 6=lost fatal"
 range 0 6
 default 0
 help
   Validation only. Nonzero values require the retained-RAM lifecycle.
   Select a controlled peer fault in the validation application only.

config BES2700_M55_RECOVERY
 bool "Validate one M55 recovery after isolation"
 depends on BES2700_M55_RESTART && BES2700_M55_FAULT_CASE > 0
 default n
 help
   Rebuild the BTH worker and reload M55 once with a new session.
   Inject only in session 1; failed recovery remains isolated.

config BES2700_M55_RECOVERY_FAIL_STEP
 int "Recovery failure injection: 0=off, 1=REPARK, 3=load, 5=new READY"
 range 0 5
 default 0
 help
   Validation only. Values 1 and 3 inject an operation failure before
   touching hardware or loading RAM. Value 5 stops the replacement
   M55 before READY. Profiles reject other nonzero values.
